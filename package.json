{
  "name": "uno-local",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "UNO 单机版本地网页游戏：1 名真人 + 2~9 名 AI，宽松叠牌，智谱 AI 混合决策",
  "workspaces": [
    "apps/server",
    "apps/desktop",
    "packages/game-core",
    "packages/ai"
  ],
  "scripts": {
    "dev": "npm run dev -w @uno/server",
    "predev": "npm run build:web-engine",
    "start": "npm run start -w @uno/server",
    "prestart": "npm run build:web-engine",
    "desktop:build": "tsx scripts/build-desktop.ts",
    "desktop:dev": "npm run desktop:build && electron apps/desktop/dist/main.cjs",
    "desktop:dist": "npm run build:web-engine && npm run dist -w @uno/desktop",
    "desktop": "electron apps/desktop/dist/main.cjs",
    "build:web-engine": "tsx scripts/build-web-engine.ts",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:online": "node scripts/verify-online.mjs",
    "verify:desktop": "node scripts/verify-desktop.mjs",
    "perf": "node scripts/perf-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "smoke:ai": "tsx scripts/smoke-ai.ts",
    "selfplay": "tsx scripts/selfplay.ts",
    "profile:ai": "tsx scripts/ai-profile.ts",
    "demo:deal": "tsx scripts/deal-demo.ts",
    "demo:turn": "tsx scripts/turn-demo.ts",
    "process:cards": "python scripts/process-cards.py"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
