# ===== UNO 本地服务 =====
# 本地服务端口（前端静态页与 /api 共用同一个端口）
PORT=3000

# ===== 智谱开放平台（可选）=====
# 不填也能玩：游戏与本地 AI 完全离线可用，只是 AI 不会"思考"和说话。
# 获取 Key: https://bigmodel.cn/usercenter/proj-mgmt/apikeys
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 首选免费模型
ZHIPU_MODEL=glm-4.7-flash
# 失败/下线时自动切换的备用模型（逗号分隔）
ZHIPU_FALLBACK_MODELS=glm-4.5-flash,glm-4-flash
# AI 单次决策超时（毫秒），超时自动降级本地 AI（免费模型波动较大，默认 6s，可调 2~8s）
AI_DECISION_TIMEOUT_MS=6000
